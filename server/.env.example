MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cortisol-dev.pongjtg.mongodb.net/?appName=cortisol-dev
MONGODB_DATABASE=cortisol

DB_USERNAME=cortisol_app
DB_PASSWORD=X

# GitHub OAuth (device flow) — required for login / knowledge auth.
# Create an OAuth App, enable Device Flow, then paste the Client ID here.
GITHUB_CLIENT_ID=
# Optional for some OAuth Apps; include if GitHub shows a client secret.
# GITHUB_CLIENT_SECRET=
# Optional: defaults to seeded NovaPay org ObjectId hex.
# CORTISOL_DEFAULT_ORG_ID=
# Optional session lifetime (default 720h).
# AUTH_SESSION_TTL=720h

# Snowflake Cortex REST API (no Snowflake database or warehouse required).
SNOWFLAKE_ACCOUNT_URL=https://<organization>-<account>.snowflakecomputing.com
SNOWFLAKE_PAT=<programmatic-access-token>
SNOWFLAKE_MODEL=claude-sonnet-4-6
EVALUATION_TIMEOUT=60s
# Local development API; keep bound to loopback.
HTTP_ADDR=127.0.0.1:8080
