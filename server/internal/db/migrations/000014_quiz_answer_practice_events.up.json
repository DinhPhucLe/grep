                  "int",
                  "null"
                ]
              },
              "repo_name": {
                "bsonType": "string"
              },
              "repo_org": {
                "bsonType": "string"
              },
              "file_path": {
                "bsonType": "string"
              },
              "module": {
                "bsonType": "string"
              },
              "start_line": {
                "bsonType": "int"
              },
              "end_line": {
                "bsonType": "int"
              },
              "answer_quality": {
                "bsonType": [
                  "string",
                  "null"
                ]
              },
              "relevance": {
                "bsonType": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "bsonType": "object",
            "required": [
              "_id",
              "source",
              "practice",
              "user_id",
              "quiz_id",
              "question_id",
              "grade",
              "started_at",
              "ended_at",
              "outcome"
            ],
            "additionalProperties": false,
            "properties": {
              "_id": {
                "bsonType": "objectId"
              },
              "source": {
                "enum": [
                  "quiz_answers"
                ]
              },
              "practice": {
                "enum": [
                  "lead_and_reveal"
                ]
              },
              "user_id": {
                "bsonType": "objectId"
              },
              "organization_id": {
                "bsonType": "objectId"
              },
              "quiz_id": {
                "bsonType": "objectId"
              },
              "question_id": {
                "bsonType": "string",
                "pattern": "^q[1-9][0-9]*$"
              },
              "grade": {
                "bsonType": [
                  "double",
                  "int",
                  "long",
                  "decimal"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "started_at": {
                "bsonType": "date"
              },
              "ended_at": {
                "bsonType": "date"
              },
              "outcome": {
                "enum": [
                  "correct",
                  "failed_reveal"
                ]
              }
            }
          }
        ]
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
