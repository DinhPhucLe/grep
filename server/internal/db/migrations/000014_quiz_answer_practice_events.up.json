                "bsonType": "objectId"
              },
              "practice": {
                "bsonType": "string"
              },
              "organization_id": {
                "bsonType": "objectId"
              },
              "user_id": {
                "bsonType": "objectId"
              },
              "session_id": {
                "bsonType": "objectId"
              },
