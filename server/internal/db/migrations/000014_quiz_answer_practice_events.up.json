                "bsonType": "date"
              },
              "ended_at": {
                "bsonType": "date"
              },
              "total_duration_ms": {
                "bsonType": [
                  "long",
                  "int"
                ]
              },
              "active_answer_time_ms": {
                "bsonType": [
                  "long",
                  "int"
                ]
              },
              "attempts": {
                "bsonType": "int"
              },
              "outcome": {
                "bsonType": "string"
              },
              "points_delta": {
